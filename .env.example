# NepSyc environment variables.
#
# Copy this to .env and fill in ONLY the key(s) for the provider(s) your config.yaml
# actually routes to -- you don't need every line below, just whichever provider(s)
# run.default_provider, target_models[].provider, or judges.provider point at.
#
# Everything here is a SECRET (an API key) and nothing else. Non-secret provider
# settings -- base_url, api_version, requests_per_minute -- live in config.yaml's
# `providers:` block, not here, for every provider including Azure.
#
# Naming convention: config.py auto-derives each provider's expected env var as
# f"{provider_name.upper()}_API_KEY" unless a providers.<name>.api_key_env line in
# config.yaml overrides it. The names below match config.yaml's shipped provider
# blocks as-is -- if you rename a provider block, rename its key here too.

# --- self-hosted / private endpoint (providers.ank in config.yaml) ---------------
ANK_API_KEY=

# --- Groq (providers.groq; also the fallback default even with no providers: block) ---
GROQ_API_KEY=

# --- OpenAI (providers.openai; only needed if a target_models entry or ---------
# judges.provider actually uses provider: openai) -------------------------------
OPENAI_API_KEY=

# --- Gemini (providers.gemini; only needed for provider: gemini, e.g. ----------
# `python run.py evaluate --gemini-judge`) ---------------------------------------
GEMINI_API_KEY=

# --- Azure OpenAI (providers.azure; only needed for provider: azure) -----------
# base_url and api_version for Azure are NOT read from the environment -- see the
# providers.azure block in config.yaml. Only the key itself belongs here, same as
# every provider above.
AZURE_API_KEY=
